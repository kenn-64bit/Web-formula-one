# ---- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Xendit --------------------------------------------------------------
# Dashboard > Settings > API Keys (use a test-mode secret key first)
XENDIT_SECRET_KEY=
# Dashboard > Settings > Webhooks > Verification token
XENDIT_CALLBACK_TOKEN=
# Point the "Invoice paid" webhook at: https://<host>/api/webhooks/xendit

# ---- Telegram --------------------------------------------------------------
# From @BotFather. Bot must be an ADMIN of the VIP channel/group with rights to
# invite users via link and to ban members.
TELEGRAM_BOT_TOKEN=
# Numeric chat id of the VIP channel/group, e.g. -1001234567890
TELEGRAM_VIP_CHAT_ID=

# ---- Cron --------------------------------------------------------------
# Any long random string. Vercel Cron sends it as `Authorization: Bearer <value>`.
CRON_SECRET=

# ---- Site --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
