# ---- Supabase (datastore only — no Auth) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Xendit -------------------------------------------------------------
# Dashboard > Settings > API Keys (use a test-mode secret key first)
XENDIT_SECRET_KEY=
# Dashboard > Settings > Webhooks > Verification token
XENDIT_CALLBACK_TOKEN=
# Point the "Invoice paid" webhook at: https://<host>/api/webhooks/xendit

# ---- Telegram --------------------------------------------------------------
# From @BotFather. Bot must be an ADMIN of the VIP channel/group with the
# "invite users via link" right.
TELEGRAM_BOT_TOKEN=
# Numeric chat id of the VIP channel/group, e.g. -1001234567890
TELEGRAM_VIP_CHAT_ID=

# ---- Email (Resend) ------------------------------------------------------
# resend.com > API Keys
RESEND_API_KEY=
# Verified sender, e.g. "APEX Signals <vip@yourdomain.com>"
RESEND_FROM=

# ---- Site --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
